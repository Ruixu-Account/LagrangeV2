<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Lagrange.Core\Lagrange.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <TrimmerRootAssembly Include="Lagrange.Core" Preserve="All"/>
    </ItemGroup>

    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-bionic-arm64'">
      <PackageReference Include="Microsoft.NETCore.App.Runtime.NativeAOT.linux-bionic-arm64" Version="10.0.0" />
    </ItemGroup>

</Project>
