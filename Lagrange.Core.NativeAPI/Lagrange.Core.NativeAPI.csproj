<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Lagrange.Core\Lagrange.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <TrimmerRootAssembly Include="Lagrange.Core" Preserve="All"/>
    </ItemGroup>

    <!-- 新增：交叉编译到 linux-bionic-arm64 所需的 ILCompiler 包 -->
    <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-bionic-arm64'">
      <PackageReference Include="runtime.linux-bionic-arm64.Microsoft.DotNet.ILCompiler" Version="10.0.0" />
    </ItemGroup>

</Project>
